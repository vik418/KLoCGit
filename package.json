{
  "name": "klocgit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Decision coordination for concurrent Git work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vik418/klocgit.git"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node server/local.mjs",
    "build": "vite build",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs tests/v1/*.test.mjs",
    "demo:reset": "node scripts/demo.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deploy": "wrangler deploy",
    "check:worker": "wrangler deploy --config wrangler.jsonc --dry-run",
    "check:executor": "wrangler deploy --config wrangler.executor.jsonc --dry-run --containers-rollout=none",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run check:worker && npm run check:executor",
    "test:browser": "node tests/browser-native.smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "test:v1": "node --test tests/v1/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0",
    "cbor2": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.24.4",
    "globals": "^16.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0",
    "undici": "^8.11.2",
    "vite": "^7.1.0",
    "wrangler": "^4.76.0"
  }
}
