{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"converge-git-executor",
  "main":"worker/executor.mjs",
  "compatibility_date":"2026-10-02",
  "workers_dev":false,
  "containers":[{"class_name":"GitExecutorContainer","image":"./Dockerfile.executor","max_instances":1,"instance_type":"standard-1"}],
  "durable_objects":{"bindings":[{"name":"EXECUTOR","class_name":"GitExecutorContainer"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["GitExecutorContainer"]}],
  "vars":{"WORKSPACE_ID":"northstar","LIVE_TEST_ENABLED":"false"}
}
